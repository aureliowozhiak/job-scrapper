# ============================================
# Job Scrapper Pro - Environment Configuration
# ============================================
# Copy this file to .env and update values

# Application
APP_NAME=Job Scrapper Pro
APP_VERSION=3.0.0
DEBUG=false

# Server
HOST=0.0.0.0
PORT=8000
RELOAD=true

# API
API_PREFIX=/api
DOCS_URL=/api/docs
REDOC_URL=/api/redoc

# Database
# SQLite (default)
DATABASE_URL=sqlite:///./data/db/jobs.db
# PostgreSQL (optional upgrade)
# DATABASE_URL=postgresql://user:password@localhost:5432/jobscrapper

# Redis (for RQ job queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=yourpassword  # Optional

# Background Jobs
ENABLE_BACKGROUND_JOBS=true
JOB_TIMEOUT=600           # 10 minutes in seconds
JOB_RESULT_TTL=3600       # 1 hour in seconds

# Scraping
SCRAPING_TIMEOUT=30
MAX_RETRIES=3
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36

# Validation
ENABLE_PRE_VALIDATION=true
VALIDATION_SAMPLE_SIZE=100
VALIDATION_BATCH_SIZE=50

# Authentication & Security
ADMIN_ENABLED=true
ADMIN_USERNAME=admin
# Default password is "admin123" - CHANGE THIS IN PRODUCTION
# To generate a new password hash, run:
# python -c "from passlib.hash import bcrypt; print(bcrypt.hash('your_password'))"
ADMIN_PASSWORD_HASH=$2b$12$LQv3c1yqBWVHxkd0LHAkCOYz6TtxMQJqhN8/LewY5uyE0lM/cKK4u
# Session secret - CHANGE THIS TO A RANDOM STRING IN PRODUCTION
SESSION_SECRET_KEY=change-this-in-production-to-a-secure-random-key

# Directories (relative to project root)
# These are created automatically if they don't exist
DATA_DIR=data
LAKE_DIR=data/lake
OUTPUT_DIR=data/output
LOGS_DIR=data/logs
DB_DIR=data/db

# Docker-specific (uncomment when running in Docker)
# REDIS_HOST=redis
# DATABASE_URL=sqlite:///./data/db/jobs.db
